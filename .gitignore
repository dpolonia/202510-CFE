# --- Security / Secrets (NEVER COMMIT THESE) ---
.env
.env.*
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.class

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- OS & System Files (Windows/WSL/Mac) ---
.DS_Store
Thumbs.db
Desktop.ini
# WSL specific artifact seen in your file list
*:Zone.Identifier

# --- Project Specific Ignored Folders ---
# Archived data (already in _archived subfolder)
03_data/raw/_archived/
# Temporary files
firebase-debug.log
*.log

# --- Virtual Environments ---
# (Common names, just in case you create one later)
venv/
env/
.venv/

# --- Optional: Large Data Files ---
# GitHub rejects files > 100MB.
# Uncomment lines below if you want to stop syncing raw data:
# 03_data/raw/**/*.csv
# 03_data/raw/**/*.xlsx
# 03_data/raw/**/*.parquet
# 03_data/raw/**/*.zip
# But keep processed data and metadata
!03_data/processed/
!03_data/metadata/
